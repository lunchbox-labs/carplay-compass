#!/usr/bin/env python3
"""Publish manual internal builds or stable releases; keep credential-tool output private."""
import base64
import json
import os
from pathlib import Path
import plistlib
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import uuid
from metadata_sync import MetadataError, read_copy, uploaded_identity

APP = 'dev.lunchbox-labs.carplay-compass'
ACTIVITY = APP + '.activity'
WATCH = APP + '.watchkitapp'

ROOT = Path(__file__).resolve().parents[1]
WORK = Path(os.environ.get('RUNNER_TEMP', '/tmp')) / 'compass-testflight'
KEYCHAIN = WORK / 'signing.keychain-db'
STAGE = 'preflight'


# Stream build and delivery tools; credential-handling output stays private.
STREAM_OPERATIONS = {('xcodebuild', 'archive'), ('xcodebuild', 'export archive'),
                     ('xcrun', 'Apple validation'), ('xcrun', 'upload')}


class SigningError(ValueError):
    """A fixed message safe to print without credential contents."""


def require(condition, message):
    if not condition:
        raise SigningError(message)


class ToolError(SigningError):
    def __init__(self, operation, returncode):
        super().__init__(operation + ' failed (exit code ' + str(returncode) + ').')
        self.exit_code = returncode if returncode > 0 else 128 - returncode


def mask(value):
    # Actions consumes these commands before streamed build output can expose a
    # decoded key or generated password. Never emit masking commands locally.
    require(os.environ.get('GITHUB_ACTIONS') == 'true', 'Secret masking requires GitHub Actions.')
    for part in dict.fromkeys([value, *value.splitlines()]):
        if part:
            escaped = part.replace('%', '%25').replace('\r', '%0D').replace('\n', '%0A')
            print('::add-mask::' + escaped, flush=True)


def run(*args, operation, check=True, **kwargs):
    output = None if (args[0], operation) in STREAM_OPERATIONS else subprocess.PIPE
    try:
        result = subprocess.run([str(a) for a in args], stdout=output, stderr=output, **kwargs)
    except OSError:
        raise SigningError(operation + ' could not start.') from None
    if check and result.returncode:
        raise ToolError(operation, result.returncode)
    return result


def cleanup():
    # State exists before changing the search list or installing any profile.
    state = WORK / 'cleanup.json'
    if state.exists():
        data = json.loads(state.read_text())
        failures = []
        for args, operation in [
            (['security', 'list-keychains', '-d', 'user', '-s', *data['keychains']], 'restore keychain search list'),
            (['security', 'delete-keychain', KEYCHAIN], 'delete signing keychain'),
        ]:
            try:
                result = run(*args, check=False, operation=operation)
                if result.returncode and (operation != 'delete signing keychain' or KEYCHAIN.exists()):
                    failures.append(operation + ' (exit code ' + str(result.returncode) + ')')
            except SigningError:
                failures.append(operation)
        for path in data['profiles']:
            try:
                Path(path).unlink(missing_ok=True)
            except OSError:
                failures.append('remove installed profile')
        # Retain only nonsecret retry metadata, never credential/build material.
        for path in WORK.iterdir():
            if path == state:
                continue
            try:
                if path.is_dir() and not path.is_symlink():
                    shutil.rmtree(path)
                else:
                    path.unlink(missing_ok=True)
            except OSError:
                failures.append('remove temporary signing material')
        require(not failures, 'Cleanup could not ' + ', '.join(failures) + '; retry cleanup.')
    shutil.rmtree(WORK, ignore_errors=False) if WORK.exists() else None


def decode(name, filename):
    value = os.environ.get(name, '')
    require(bool(value), 'Missing required Actions secret: ' + name)
    path = WORK / filename
    payload = base64.b64decode(''.join(value.split()), validate=True)
    if name == 'ASC_API_PRIVATE_KEY_BASE64':
        mask(payload.decode('utf-8'))
    path.write_bytes(payload)
    return path


def publish():
    global STAGE
    require(os.environ.get('GITHUB_ACTIONS') == 'true', 'Run in GitHub Actions.')
    read_copy(ROOT / 'app-store')
    event = os.environ.get('GITHUB_EVENT_NAME')
    version = None
    if event == 'workflow_dispatch':
        require(os.environ.get('GITHUB_REF') == 'refs/heads/main', 'Run manually from main.')
    elif event == 'release':
        payload = json.loads(Path(os.environ['GITHUB_EVENT_PATH']).read_text())
        release = payload['release']
        require(payload.get('action') == 'published' and release.get('draft') is False and
                release.get('prerelease') is False, 'Only published stable releases can upload.')
        tag = release.get('tag_name', '')
        match = re.fullmatch(r'v?((?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*))', tag)
        require(match and os.environ.get('GITHUB_REF') == 'refs/tags/' + tag,
                'Release tag must be X.Y.Z or vX.Y.Z, without prerelease or build metadata.')
        version = match.group(1)
    else:
        raise SigningError('Only manual main builds or published stable releases can upload.')
    build = os.environ.get('BUILD_NUMBER', '')
    require(re.fullmatch(r'[1-9][0-9]{0,3}\.[1-9][0-9]?', build),
            'Workflow build number must be run.attempt (run 1–9999, attempt 1–99).')
    team = os.environ.get('APPLE_TEAM_ID', '')
    key = os.environ.get('ASC_API_KEY_ID', '')
    issuer = os.environ.get('ASC_API_ISSUER_ID', '')
    require(re.fullmatch('[A-Z0-9]{10}', team) and re.fullmatch('[A-Z0-9]+', key), 'Missing/invalid team or API key ID.')
    uuid.UUID(issuer)
    require(os.environ.get('IOS_DISTRIBUTION_P12_PASSWORD'), 'Missing p12 password.')
    require(os.environ.get('WATCH_APP_PROFILE_BASE64'),
            'Watch publishing requires WATCH_APP_PROFILE_BASE64 for ' + WATCH + '; configure its distribution profile before publishing.')
    require(not WORK.exists(), 'Stale signing directory; run cleanup first.')
    WORK.mkdir(mode=0o700)
    state = {'keychains': shlex.split(run('security', 'list-keychains', '-d', 'user', operation='read keychain search list').stdout.decode()), 'profiles': []}
    state_path = WORK / 'cleanup.json'
    state_path.write_text(json.dumps(state))
    STAGE = 'signing setup'
    p12 = decode('IOS_DISTRIBUTION_P12_BASE64', 'identity.p12')
    paths = [decode('IOS_APP_PROFILE_BASE64', 'app.mobileprovision'),
             decode('IOS_ACTIVITY_PROFILE_BASE64', 'activity.mobileprovision'),
             decode('WATCH_APP_PROFILE_BASE64', 'watch.mobileprovision')]
    decode('ASC_API_PRIVATE_KEY_BASE64', 'AuthKey_' + key + '.p8')
    password = secrets.token_urlsafe(32)
    mask(password)
    run('security', 'create-keychain', '-p', password, KEYCHAIN, operation='create signing keychain')
    run('security', 'set-keychain-settings', '-lut', '21600', KEYCHAIN, operation='configure signing keychain')
    run('security', 'unlock-keychain', '-p', password, KEYCHAIN, operation='unlock signing keychain')
    run('security', 'list-keychains', '-d', 'user', '-s', KEYCHAIN, *state['keychains'], operation='select signing keychain')
    run('security', 'import', p12, '-k', KEYCHAIN, '-P', os.environ['IOS_DISTRIBUTION_P12_PASSWORD'],
        '-T', '/usr/bin/codesign', '-T', '/usr/bin/security', operation='import signing identity')
    run('security', 'set-key-partition-list', '-S', 'apple-tool:,apple:,codesign:', '-s', '-k', password, KEYCHAIN, operation='authorize signing tools')
    # Parse only the UUID needed to install/map each profile; Apple tools
    # validate the certificate, profiles, entitlements and signed products.
    profiles = []
    for path in paths:
        metadata = plistlib.loads(run('security', 'cms', '-D', '-i', path,
                                     operation='read profile UUID').stdout)
        profile_id = metadata['UUID']
        uuid.UUID(profile_id)
        mask(profile_id)
        if metadata.get('Name'):
            mask(metadata['Name'])
        profiles.append(profile_id)
    installed = Path.home() / 'Library/Developer/Xcode/UserData/Provisioning Profiles'
    installed.mkdir(parents=True, exist_ok=True)
    for source, profile_id in zip(paths, profiles):
        destination = installed / (profile_id + '.mobileprovision')
        require(not destination.exists(), 'Profile already installed; use a fresh runner.')
        state['profiles'].append(str(destination))
        state_path.write_text(json.dumps(state))
        shutil.copyfile(source, destination)
    STAGE = 'project conversion'
    source = WORK / 'source'
    shutil.copytree(ROOT, source, ignore=shutil.ignore_patterns('.git', '.build', '__pycache__'))
    project = source / 'Compass.xcodeproj/project.pbxproj'
    data = json.loads(run('plutil', '-convert', 'json', '-o', '-', project, operation='convert project').stdout)
    seen = set()
    for obj in data['objects'].values():
        settings = obj.get('buildSettings', {})
        bundle = settings.get('PRODUCT_BUNDLE_IDENTIFIER')
        if bundle in [APP, ACTIVITY, WATCH]:
            profile_id = profiles[[APP, ACTIVITY, WATCH].index(bundle)]
            settings.update(CODE_SIGN_STYLE='Manual', DEVELOPMENT_TEAM=team,
                            CODE_SIGN_IDENTITY='Apple Distribution', PROVISIONING_PROFILE_SPECIFIER=profile_id,
                            CURRENT_PROJECT_VERSION=build)
            if version is not None:
                settings['MARKETING_VERSION'] = version
            seen.add(bundle)
    require(seen == {APP, ACTIVITY, WATCH}, 'Project target IDs changed; review signing configuration.')
    project.write_bytes(plistlib.dumps(data))
    STAGE = 'archive'
    archive = WORK / 'Compass.xcarchive'
    run('xcodebuild', '-project', source / 'Compass.xcodeproj', '-scheme', 'Compass',
        '-configuration', 'Release', '-destination', 'generic/platform=iOS',
        '-derivedDataPath', WORK / 'derived', '-archivePath', archive, 'archive', cwd=source, operation='archive')
    marketing_version = uploaded_identity(archive, APP, build)
    STAGE = 'export'
    options = WORK / 'ExportOptions.plist'
    options.write_bytes(plistlib.dumps({'method': 'app-store-connect', 'destination': 'export',
        'teamID': team, 'signingStyle': 'manual', 'signingCertificate': 'Apple Distribution',
        'provisioningProfiles': dict(zip([APP, ACTIVITY, WATCH], profiles)),
        'testFlightInternalTestingOnly': event == 'workflow_dispatch', 'manageAppVersionAndBuildNumber': False}))
    exported = WORK / 'export'
    run('xcodebuild', '-exportArchive', '-archivePath', archive, '-exportPath', exported,
        '-exportOptionsPlist', options, operation='export archive')
    STAGE = 'Apple validation'
    ipas = list(exported.glob('*.ipa'))
    require(len(ipas) == 1, 'Expected one exported IPA.')
    auth_env = dict(os.environ, API_PRIVATE_KEYS_DIR=str(WORK))
    args = ['--file', ipas[0], '--type', 'ios', '--apiKey', key, '--apiIssuer', issuer]
    upload(args, auth_env, marketing_version)


def upload(args, auth_env, marketing_version):
    """Expose the archived version only after Apple accepts this exact upload."""
    global STAGE
    run('xcrun', 'altool', '--validate-app', *args, env=auth_env, operation='Apple validation')
    STAGE = 'upload (check App Store Connect before retrying an interrupted upload)'
    run('xcrun', 'altool', '--upload-app', *args, env=auth_env, operation='upload')
    print('Apple accepted the upload. Processing is still pending; no App Review submission was made.')
    STAGE = 'recording accepted upload (Apple has already accepted the build)'
    with Path(os.environ['GITHUB_OUTPUT']).open('a', encoding='utf-8') as output:
        output.write('marketing_version=' + marketing_version + '\n')


def main():
    try:
        if sys.argv[1:] == ['cleanup']:
            cleanup()
        elif not sys.argv[1:]:
            try:
                publish()
            finally:
                cleanup()
        else:
            raise ValueError('Usage: python3 scripts/testflight [cleanup]')
    except Exception as error:
        # Never print exception text from subprocess, plist, JSON or credential decoding.
        detail = str(error) if isinstance(error, (SigningError, MetadataError)) else 'Review the build inputs and configuration.'
        print('TestFlight failed during ' + STAGE + ': ' + detail, file=sys.stderr)
        return error.exit_code if isinstance(error, ToolError) else 1
    return 0


if __name__ == '__main__':
    os.umask(0o077)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    sys.exit(main())
