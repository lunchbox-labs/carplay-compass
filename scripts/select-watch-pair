#!/usr/bin/env python3
"""Wait for a mounted Watch runtime and its available paired phone."""
import json
import os
import re
import subprocess
import sys
import time


def select_pair(payload, runtimes):
    mounted = {runtime.get("runtimeIdentifier") for runtime in runtimes.values()
               if runtime.get("state") == "Ready"
               and os.path.ismount(runtime.get("mountPath") or "")}
    available = {device["udid"]: device
                 for runtime, devices in payload["devices"].items()
                 if runtime in mounted
                 for device in devices if device.get("isAvailable")}
    for runtime, devices in sorted(payload["devices"].items(), reverse=True):
        match = re.search(r"\.watchOS-(\d+)-", runtime)
        if not match or int(match.group(1)) < 27 or runtime not in mounted:
            continue
        for device in devices:
            if device["udid"] not in available or not device["name"].startswith("Apple Watch"):
                continue
            for pair in payload.get("pairs", {}).values():
                phone = available.get(pair["phone"]["udid"])
                if pair["watch"]["udid"] == device["udid"] and phone:
                    return device, phone
    return None


def summarize(payload, runtimes):
    """Describe the Watch-related runtime and device state for a failure report."""
    watch_runtimes = sorted(runtime.get("state", "?") + " at " + str(runtime.get("mountPath"))
                            for runtime in runtimes.values()
                            if "watchOS" in str(runtime.get("runtimeIdentifier")))
    lines = ["Watch runtimes: " + (", ".join(watch_runtimes) or "none")]
    for runtime, devices in sorted(payload.get("devices", {}).items()):
        if ".watchOS-" in runtime or ".iOS-" in runtime:
            states = [device["name"] + (" available" if device.get("isAvailable") else " unavailable")
                      for device in devices]
            lines.append(runtime.rsplit(".", 1)[-1] + ": " + (", ".join(states) or "no devices"))
    lines.append("Pairs: " + str(len(payload.get("pairs", {}))))
    return "\n".join(lines)


def wait_for_pair(timeout=180, clock=time.monotonic):
    # The image can replace its initially mounted Watch runtime after the build.
    # Re-read both runtime and device state instead of treating a missing pair as final.
    deadline = clock() + timeout
    snapshots = []
    while clock() < deadline:
        try:
            snapshots = []
            for arguments in (["runtime", "list", "-j"], ["list", "--json"]):
                remaining = deadline - clock()
                if remaining <= 0:
                    break
                result = subprocess.run(["xcrun", "simctl", *arguments], check=True,
                                        capture_output=True, text=True,
                                        timeout=min(30, remaining))
                snapshots.append(json.loads(result.stdout))
            if len(snapshots) == 2:
                pair = select_pair(snapshots[1], snapshots[0])
                if pair:
                    return pair
            print("Waiting for a mounted watchOS 27+ runtime and available paired iPhone", file=sys.stderr, flush=True)
        except (subprocess.SubprocessError, ValueError) as error:
            print("Watch simulator discovery failed: " + str(error), file=sys.stderr, flush=True)
        time.sleep(min(2, max(0, deadline - clock())))
    if len(snapshots) == 2:
        print(summarize(snapshots[1], snapshots[0]), file=sys.stderr, flush=True)
    raise RuntimeError("No mounted watchOS 27+ Watch with an available paired iPhone within " + str(timeout) + " seconds")


if __name__ == "__main__":
    try:
        watch, phone = wait_for_pair()
    except RuntimeError as error:
        sys.exit(str(error))
    print("Selected " + watch["name"] + " with " + phone["name"], file=sys.stderr)
    print(watch["udid"], phone["udid"])
