#!/usr/bin/env bash
set -euo pipefail
date -u "+%Y-%m-%dT%H:%M:%SZ Discovering Watch simulator pair"
selection="$(python3 scripts/select-watch-pair)"
read -r destination companion <<< "$selection"
# XCTest uses the existing paired iPhone for its Watch transport. Wait for both
# simulators to finish booting before starting the test runner's handshake. A first
# Watch boot on the hosted runner regularly needs several minutes, so the wait fails
# on a stalled phase rather than on a fixed total. Boot the Watch first: once the
# iPhone finishes its own first boot its background work starves the runner, and a
# Watch boot started then has timed out before reaching CoreSimulator.
python3 scripts/wait-for-boot "$destination" "$companion"
# Pay for the app's first install and launch here, under a visible bound, instead of
# inside XCTest's host handshake, which gives up after about five minutes.
python3 scripts/warm-watch-app "$destination" \
  .build/watch/Build/Products/Debug-watchsimulator/CompassWatch.app \
  dev.lunchbox-labs.carplay-compass.watchkitapp
mkdir -p .build

run_tests() {
  result_directory="$(mktemp -d .build/watch-test-results.XXXXXX)"
  date -u "+%Y-%m-%dT%H:%M:%SZ Starting Watch xcodebuild tests"
  xcodebuild -project Compass.xcodeproj -scheme CompassWatch \
    -destination "platform=watchOS Simulator,id=$destination" \
    -derivedDataPath .build/watch -resultBundlePath "$result_directory/CompassWatchTests.xcresult" \
    CODE_SIGNING_ALLOWED=NO test 2>&1 | tee "$result_directory/xcodebuild.log"
}

# Preserve the first native result, including host-launch failures. A matching log
# message is not sufficient to prove that no test assertions ran or failed.
status=0
run_tests || status=$?
if (( status == 0 )); then
  date -u "+%Y-%m-%dT%H:%M:%SZ Watch xcodebuild tests succeeded"
fi
exit "$status"
